{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:minimumReleaseAgeNpm",
    ":configMigration",
    ":semanticCommits",
    ":timezone(America/New_York)",
  ],
  "dependencyDashboard": { "title": "Renovate Dashboard 🤖" },
  "schedule": ["* * 1 * *"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * 1 * *"],
  },
  "packageRules": [
    {
      "description": "Bump npm ranges in package.json to the new version",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump",
    },
    {
      "description": "Auto-merge non-major npm updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dependencies",
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Group mise tool bumps and auto-merge non-major ones",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "toolchain",
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Bump the Node pin (.node-version) and pnpm pins (mise, packageManager) together",
      "matchDepNames": ["node", "pnpm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "toolchain",
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr",
    },
    {
      "description": "A 0.x minor can break, so split it from the group and don't auto-merge it",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "additionalBranchPrefix": "major-",
      "automerge": false,
    },
    {
      "description": "Auto-merge GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "minimumReleaseAge": "3 days",
      "ignoreTests": true,
    },
    {
      "description": "Auto-merge trusted GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^actions\\//", "/^renovatebot\\//"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "minimumReleaseAge": "1 minute",
      "ignoreTests": true,
    },
  ],
}
